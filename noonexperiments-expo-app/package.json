{
  "name": "noonexperiments",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "prebuild:ios": "npx expo prebuild --platform ios --clean",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "eas:build:development:locally:ios": "time eas build --profile development --local --platform ios",
    "eas:build:development:locally:android": "time eas build --profile development --local --platform android",
    "eas:build:preview:locally:ios": "time eas build --profile preview --local --platform ios",
    "eas:build:preview:locally:android": "time eas build --profile preview --local --platform android",
    "eas:build:production:locally:ios": "time eas build --profile production --local --platform ios",
    "eas:build:production:locally:android": "time eas build --profile production --local --platform android",
    "eas:submit:production:android": "time eas submit --platform android --profile production",
    "eas:submit:production:ios": "time eas submit --platform ios --profile production",
    "eas:clean:local:artifacts": "rm -f build-*.{apk,aab,ipa}"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~53.0.9",
    "expo-blur": "~14.1.4",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.1.8",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.1.7",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.0.6",
    "expo-share-intent": "^4.0.0",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.4",
    "expo-system-ui": "~5.0.7",
    "expo-web-browser": "~14.1.6",
    "patch-package": "^8.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "ajv": "^8.17.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
