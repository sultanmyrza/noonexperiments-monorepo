{
  "cli": {
    "version": ">= 16.19.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_APPLE_TEAM_TYPE": "COMPANY_OR_ORGANIZATION",
        "EXPO_APPLE_TEAM_ID": "B9A7V7HR98"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_APPLE_TEAM_TYPE": "COMPANY_OR_ORGANIZATION",
        "EXPO_APPLE_TEAM_ID": "B9A7V7HR98"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_APPLE_TEAM_TYPE": "COMPANY_OR_ORGANIZATION",
        "EXPO_APPLE_TEAM_ID": "B9A7V7HR98"
      }
    }
  },
  "submit": {
    "production": {}
  }
